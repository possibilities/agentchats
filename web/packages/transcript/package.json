{
  "name": "@agentchats/transcript",
  "version": "0.2.1",
  "description": "Composable Human / Agent transcripts, live sources, and React blocks",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/possibilities/agentchats.git",
    "directory": "web/packages/transcript"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/transcript/index.d.ts",
      "import": "./dist/index.js"

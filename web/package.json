{
  "name": "agentchats-reader",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24",
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun --bun vite",
    "build": "tsc -b && bun --bun vite build",
    "lint": "oxlint",
    "check": "npm run lint && npm run build && npm run build:package",
    "preview": "bun --bun vite preview",
    "test": "npm run test:api && npm run test:browser",
    "test:api": "bun test",
    "test:browser": "playwright test",
    "build:package": "bun --bun vite build --config vite.package.config.ts && tsc -p tsconfig.package.json && bun scripts/build-package.ts",
    "test:package": "bun scripts/check-package.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@pierre/diffs": "^1.4.2",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-virtual": "3.14.12",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lowlight": "3.3.0",
    "lucide-react": "^1.45.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "portless": "0.15.6",
    "unified": "^11.0.5",
    "remark-parse": "^11.0.0",
    "mdast-util-to-string": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "@types/bun": "^1.3.14",
    "postcss": "^8.5.28"
  },
  "workspaces": [
    "packages/transcript"
  ]
}

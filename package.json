{
  "name": "agentchats",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Searchable coding-agent session history: a local SQLite+FTS5 index over the Claude Code and Codex transcript stores, the agentchats CLI, and the resume picker",
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22"
  },
  "scripts": {
    "test": "bun test && node --test test/run-with-timeout.node.mjs",
    "typecheck": "bunx tsc --noEmit",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:check": "npm --prefix web run check",
    "web:test": "npm --prefix web test",
    "check": "bun run typecheck && bun run test && bun run web:check && bun run web:test",
    "serve": "./bin/agentchats serve"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@opentui/core": "^0.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.2"
  }
}

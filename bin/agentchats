#!/bin/bash

set -euo pipefail

# Agentchats CLI: the searchable index of this machine's coding-agent session
# history, and the small surface built on it.
#
# Everything below the dispatch is Bun (src/cli/main.ts). This file stays bash
# because `~/.local/bin/agentchats` is a symlink into the checkout and the
# fleet's installers expect a shell entry point; it resolves the repository,
# proves Bun is present, and hands over.
#
# `agentchats state` prints a budget-capped, workspace-scoped bearings dump —
# recent coding-agent sessions for one project — for agents that need to
# re-orient cheaply. Markdown for a model to read, not JSON for a program.
# `agentchats search <query> --json` is the agent surface; bare `agentchats
# search` opens the resume picker.
#
# Contract, shared with the other agent* state dumps:
#   - scoped to one workspace (the current git project by default)
#   - bounded by --budget (approximate tokens, ~4 characters each)
#   - fast, offline, read-only, free
#   - silent when there is nothing to say

die() {
    printf 'agentchats: %s\n' "$*" >&2
    exit 1
}

command -v bun >/dev/null 2>&1 \
    || die "agentchats needs bun; install it with AgentStart"

self=$(readlink -f "${BASH_SOURCE[0]}")
repo=$(cd "$(dirname "$self")/.." && pwd)

exec bun "$repo/src/cli/main.ts" "$@"

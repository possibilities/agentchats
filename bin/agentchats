#!/bin/bash

set -euo pipefail

# Agentchats CLI: the searchable index of this machine's coding-agent session
# history, and the small surface built on it.
#
# Everything below the dispatch is Bun (src/cli/main.ts). This file stays bash
# because `~/.local/bin/agentchats` is a symlink into the checkout and the
# fleet's installers expect a shell entry point; it resolves the repository,
# proves Bun is present, and hands over.
#
# `agentchats state` prints a budget-capped, workspace-scoped bearings dump —
# recent coding-agent sessions for one project — for agents that need to
# re-orient cheaply. Markdown for a model to read, not JSON for a program.
# `agentchats search <query> --json` is the agent surface; bare `agentchats
# search` opens the resume picker.
#
# Contract, shared with the other agent* state dumps:
#   - scoped to one workspace (the current git project by default)
#   - bounded by --budget (approximate tokens, ~4 characters each)
#   - fast, offline, read-only, free
#   - silent when there is nothing to say

die() {
    printf 'agentchats: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Usage: agentchats <command> [options]

Search and re-read this machine's Claude Code and Codex session history from
a local SQLite index over the live transcript stores.

Commands:
  state      Budget-capped bearings dump of recent sessions for one workspace
  search     Live-search sessions in a full-screen picker, or with --json,
             ranked hits for an agent to read
  sessions   Recent sessions as JSON
  view       Print one message, cited by source path and line
  expand     Print the messages around one hit
  resume     Print the native resume command for a session
  index      Build or incrementally refresh the index
  status     Index schema, counts, size, and freshness

Options (state):
  --workspace <dir>   Project directory (default: the current git project)
  --budget <tokens>   Approximate output budget (default: 400, ~4 chars/token)

Options (search, picker):
  --workspace <dir>   Project directory (default: the current git project)
  --include-auxiliary Include app-server, realtime, and child Codex threads

Options (search, --json):
  --limit N --offset N --workspace <dir> --agent claude_code|codex
  --days N --since <when> --until <when>
  --fields minimal|summary|<csv>  --max-content-length N
  --aggregate agent,workspace,date

Options (index):
  --full              Discard the index and rebuild from the live stores
  --retain-days N     Also drop sessions older than N days

The index is derived state at ~/.local/state/agentchats/index.db. Deleting it
loses nothing but the time to run `agentchats index` again.
EOF
}

case "${1:-}" in
    -h|--help|'')
        usage
        exit 0
        ;;
esac

command -v bun >/dev/null 2>&1 \
    || die "agentchats needs bun; install it with AgentStart"

self=$(readlink -f "${BASH_SOURCE[0]}")
repo=$(cd "$(dirname "$self")/.." && pwd)

exec bun "$repo/src/cli/main.ts" "$@"
